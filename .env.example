# Anthropic API (필수) — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# NCBI E-utilities API 키 (선택, 권장)
# 없으면 3 req/s, 발급 시 10 req/s
# https://account.ncbi.nlm.nih.gov/settings/
NCBI_API_KEY=

# Crossref / OpenAlex polite pool 용 연락처 (권장)
# 지정하면 rate limit 우선순위가 높아진다
CONTACT_EMAIL=you@example.com

# 라운드당 LLM 비용 상한 (USD)
COST_CAP_USD=3.0

# 데이터 저장 위치
DB_PATH=./paper_search.sqlite3
CACHE_DIR=./.cache/http
